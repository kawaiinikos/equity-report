<!doctype html><html><head><meta charset="utf-8"><style>{{ css }}</style></head><body>
{% macro header(title) %}<div class="hdr"><h1>{{ c.name }} ({{ c.ticker }})</h1><div class="sub">{{ c.sector }} · {{ title }} · Report Date: {{ c.date }}</div></div>{% endmacro %}

{% macro trend_block(title, rows, box, note) %}{% if rows %}
  <div class="row"><div class="col" style="flex:2.2"><h2>{{ title }}</h2>
  <table class="trend"><tr><th>Peers</th><th>-6M</th><th>-3M</th><th>-1M</th><th>-1W</th><th>Current</th><th>1Y Trend</th></tr>
  {% for r in rows %}<tr {% if r.target %}style="font-weight:700"{% endif %}><td>{{ r.ticker }}</td>{% for v in r.vals[:4] %}<td>{{ v }}</td>{% endfor %}<td><span class="cur">{{ r.vals[4] }}</span></td><td class="spark">{{ r.spark|safe }}</td></tr>{% endfor %}</table></div>
  {% if box %}<div class="col"><h2>Score Averages</h2><table>{% for k, v in box %}<tr><td>{{ k }}</td><td><b>{{ v }}</b></td></tr>{% endfor %}</table></div>{% endif %}</div>
  <p class="note">{{ note }}</p>{% endif %}{% endmacro %}

<div class="page">{{ header("DETAILED STOCK REPORT – Overview") }}
  <div class="stats">{% for k, v in c.key_stats %}<div class="stat"><b>{{ v }}</b><span>{{ k }}</span></div>{% endfor %}</div>
  <div class="row"><div class="col"><h2>1-Year Price &amp; Volume</h2>{{ c.chart_1y|safe }}</div>
  <div class="col"><h2>5-Year Price &amp; Volume</h2>{{ c.chart_5y|safe }}</div></div>
  <h2>Highlights</h2><ul>{% for b in c.highlights %}<li>{{ b }}</li>{% endfor %}</ul><p class="note">Generated by {{ c.highlights_source }}; every figure is validated against the report data.</p>
  <h2>Business Summary</h2><p>{{ c.summary }}</p>
  <h2>Average Score</h2>
  <span class="badge">{{ c.avg_score }}</span> <span class="pill">Outlook: <b>{{ c.outlook }}</b> · provisional: mean of available components ({{ c.n_components }}/6). </span><h2>Analyst Consensus</h2><p>{{ c.consensus }}</p><p class="note"></p></div>

<div class="page">{{ header("Indicator Components & Peer Analysis") }}
  <div class="row"><div class="col"><h2>Component Ratings (1–10)</h2>{{ c.score_chart|safe }}</div>
  <div class="col"><h2>Optimized Score</h2><span class="badge">{{ c.opt_score }}</span>
  <p class="note">Approximation: fixed-weight blend of available components. LSEG/Verus weights are proprietary. The Momentum score uses relative strength only (seasonality is shown on the momentum page but not scored).</p></div></div>
  <h2>Peer Analysis</h2>
  <table><tr>{% for h in ["Ticker","Price","1M","3M","Mkt Cap (B)","P/E","Fwd P/E","Div Yld","Net Margin"] %}<th>{{ h }}</th>{% endfor %}</tr>
  {% for r in c.peer_rows %}<tr {% if loop.first %}style="font-weight:700"{% endif %}>{% for v in r %}<td>{{ v }}</td>{% endfor %}</tr>{% endfor %}</table>
  <p class="note">Peers: nearest market cap in the same GICS sub-industry (then sector) within the S&amp;P 500 universe.</p>
  {{ trend_block("Average Score Trend (4-Week Moving Avg)", c.avg_trend, c.avg_box, "Approximation of LSEG's stored history: Risk and Price Momentum are re-ranked weekly against the S&P 500 sector cohort using prices up to each date; Earnings is rebuilt as-of each date from reported surprises and broker up/downgrades (revisions have no history); Fundamental, Valuation and Insider are held at their latest value. The Current column is the 4-week average, so it can differ from the headline score. Sector and index averages cover the four rankable components only.") }}</div>

<div class="page">{{ header("Earnings Analysis & Price Target") }}
  {% if c.gauge_earnings %}<h2>Earnings Indicators</h2>{{ c.gauge_earnings|safe }}{% endif %}
  <div class="row"><div class="col"><h2>Earnings Score</h2><span class="badge">{{ c.earn_score }}</span>
  <table style="margin-top:6px"><tr><th>Factor</th><th>Score</th></tr>{% for n, v in c.earn_factors %}<tr><td>{{ n }}</td><td>{{ v }}</td></tr>{% endfor %}</table>
  <p class="note">Factor scores use fixed absolute bins (LSEG ranks each factor market-wide).</p></div>
  <div class="col"><h2>12-Month Price Target</h2>{{ c.fan_chart|safe }}
  <p class="pill">Mean target vs current: <b>{{ c.pt_vs_current }}</b> · {{ c.n_analysts }} analysts</p></div></div>
  <h2>Surprises (last 12 quarters)</h2>
  {% if c.surp_summary %}<p>Positive {{ c.surp_summary.pos }} · Negative {{ c.surp_summary.neg }} · In-line {{ c.surp_summary.inline }} of {{ c.surp_summary.n }}. Last 4Q: {{ c.surp_summary.pos4 }} positive, {{ c.surp_summary.neg4 }} negative.</p>{% endif %}
  <h2>Estimate revisions (4 weeks) &amp; recommendation changes (120 days)</h2>
  <p>EPS estimates revised up {{ c.rev_stats.get("up30","n/a") }} / down {{ c.rev_stats.get("down30","n/a") }} (count over current/next quarter and year).
  Upgrades {{ c.rc_stats.get("up","n/a") }} / downgrades {{ c.rc_stats.get("down","n/a") }}.</p>
  {{ trend_block("Earnings Score Trend (4-Week Moving Avg)", c.earn_trend, c.earn_box, "Earnings history uses two of the three factors (surprises and recommendation changes) because estimate revisions are not available historically (so Current can differ from the 3-factor Earnings Score above); market-wide Earnings averages need I/B/E/S coverage and are shown as n/a.") }}</div>

<div class="page">{{ header("EPS Estimates, Revisions & Surprises") }}
  <div class="row"><div class="col">{{ c.eps_q_chart|safe }}</div><div class="col">{{ c.eps_a_chart|safe }}</div></div>
  <div class="row"><div class="col"><h2>Consensus EPS</h2><table><tr><th>Period</th><th>Mean</th><th>Low</th><th>High</th><th>#</th></tr>{% for r in c.est_rows %}<tr>{% for v in r %}<td>{{ v }}</td>{% endfor %}</tr>{% endfor %}</table></div>
  <div class="col"><h2>Mean estimate trend</h2><table><tr><th>Period</th><th>Current</th><th>30d ago</th><th>90d ago</th><th>% chg 90d</th></tr>{% for r in c.trend_rows %}<tr>{% for v in r %}<td>{{ v }}</td>{% endfor %}</tr>{% endfor %}</table></div></div>
  <div class="row"><div class="col"><h2>Analyst recommendations</h2>{{ c.rec_chart|safe }}</div>
  <div class="col"><h2>Revenue (USD bn)</h2><table><tr><th>Period</th><th>Revenue</th></tr>{% for r in c.rev_rows %}<tr>{% for v in r %}<td>{{ v }}</td>{% endfor %}</tr>{% endfor %}</table></div></div>
  <h2>Surprise detail (last 6 quarters)</h2>
  <table><tr><th>Report date</th><th>Actual EPS</th><th>Mean EPS</th><th>Surprise</th><th>Category</th></tr>{% for r in c.surprise_rows %}<tr>{% for v in r %}<td>{{ v }}</td>{% endfor %}</tr>{% endfor %}</table>
  <p class="note">"Not comparable" = surprise above ±{{ c.method.surprise_outlier }}%: Yahoo often pairs a GAAP reported EPS (including investment gains) with an adjusted consensus estimate, so these quarters are excluded from the counts and the Earnings score.</p></div>

<div class="page">{{ header("Fundamental Analysis") }}
  {% if c.gauge_fundamental %}<h2>Fundamental Indicators</h2>{{ c.gauge_fundamental|safe }}{% endif %}
  <p class="pill">Four pillars, 25% weight each (renormalised if a pillar is unavailable). The Fundamental score is a decile rank of the average pillar score within the sector.</p>
  {% for pillar, rows in c.fundamental.items() %}<h2>{{ pillar }}</h2>
  <table><tr><th>Ratio</th><th>Formula</th><th>Value</th></tr>
  {% for name, formula, val in rows %}<tr><td>{{ name }}</td><td style="text-align:left;font-size:7pt;color:#5b6b7d">{{ formula }}</td><td>{{ val }}</td></tr>{% endfor %}</table>{% endfor %}</div>

<div class="page">{{ header("Relative Valuation") }}
  {% if c.gauge_valuation %}<h2>Relative Valuation Indicators</h2>{{ c.gauge_valuation|safe }}{% endif %}
  <h2>Valuation multiples</h2>
  <table><tr><th>Multiple</th><th>Current</th><th>5Y avg (proxy)</th><th>Industry median</th><th>S&amp;P 500 median</th></tr>
  {% for r in c.val_rows %}<tr>{% for v in r %}<td>{{ v }}</td>{% endfor %}</tr>{% endfor %}</table>
  <p class="note">Relative Valuation score: {{ c.val_score }} (P/S, trailing P/E, forward P/E at 33.3% each, ranked within sector).
  5Y averages are proxies from annual statements (~4 fiscal years available); forward P/E and PEG history need a paid data source.</p>
  <h2>Historical multiples</h2>
  <div class="row"><div class="col">{{ c.hist_ps|safe }}</div><div class="col">{{ c.hist_pe|safe }}</div></div>
  <p class="note">Forward P/E and Forward PEG (current {{ c.peg }}) have no price-history series because point-in-time consensus estimates are not available from Yahoo Finance; the current values and benchmarks are in the table above.</p></div>

<div class="page">{{ header("Market Risk Analysis") }}
  {{ trend_block("Risk Score Trend (4-Week Moving Avg)", c.risk_trend, [], "Risk is re-ranked weekly against the S&P 500 sector cohort using prices up to each date (lower risk = higher score).") }}
  {% if c.gauge_risk %}<h2>Risk Indicators</h2>{{ c.gauge_risk|safe }}{% endif %}
  <h2>Risk statistics</h2>
  <table><tr><th>Metric</th><th>{{ c.ticker }}</th></tr>{% for k, v in c.risk %}<tr><td>{{ k }}</td><td>{{ v }}</td></tr>{% endfor %}</table>
  <h2>Peer risk comparison</h2>
  <table><tr><th>Ticker</th><th>Volatility</th><th>Beta</th><th>Correlation</th><th>90d range</th></tr>
  {% for r in c.peer_risk %}<tr {% if loop.first %}style="font-weight:700"{% endif %}>{% for v in r %}<td>{{ v }}</td>{% endfor %}</tr>{% endfor %}</table>
  <p class="note">Beta/correlation vs S&amp;P 500 (1Y daily).</p></div>

<div class="page">{{ header("Price Momentum & Technicals") }}
  {{ trend_block("Price Momentum Score Trend (4-Week Moving Avg)", c.mom_trend, [], "Relative-strength score re-ranked weekly against the S&P 500 sector cohort; seasonality is not included in the score.") }}
  {% if c.gauge_momentum %}<h2>Price Momentum Indicators</h2>{{ c.gauge_momentum|safe }}{% endif %}
  <div class="row"><div class="col"><h2>Relative Strength</h2>
    <table><tr><th>Indicator</th><th>Value</th></tr>{% for k, v in c.momentum %}<tr><td>{{ k }}</td><td>{{ v }}</td></tr>{% endfor %}</table></div>
  <div class="col"><h2>Performance vs DJIA</h2>{{ c.perf_chart|safe }}</div></div>
  <h2>10-Year Seasonality (avg monthly return)</h2>
  <table><tr><th>Month</th>{% for m in c.season_months %}<th>{{ m }}</th>{% endfor %}</tr>
  <tr><td>Avg return</td>{% for v in c.season_avg %}<td>{{ v }}</td>{% endfor %}</tr>
  <tr><td>% positive</td>{% for v in c.season_pos %}<td>{{ v }}</td>{% endfor %}</tr></table></div>

<div class="page">{{ header("Insider Trading & Major Holders") }}
  {% if c.gauge_insider %}<h2>Insider Trading Indicators</h2>{{ c.gauge_insider|safe }}{% endif %}
  <div class="row"><div class="col"><h2>Insider Trading Score</h2><span class="badge">{{ c.ins_score }}</span>
  <p class="note">Short-term (90d) 70% / long-term (12m) 30%, from open-market buys and sells ($ value). NR = no open-market activity.</p>
  <h2>6-Month Summary (shares)</h2><table><tr><th>Acquired</th><th>Disposed</th><th>Net</th></tr><tr><td>{{ "{:,}".format(c.ins_sum.acquired) }}</td><td>{{ "{:,}".format(c.ins_sum.disposed) }}</td><td>{{ "{:,}".format(c.ins_sum.net) }}</td></tr></table></div>
  <div class="col"><h2>12-Month Buys &amp; Sells</h2>{{ c.ins_chart|safe }}</div></div>
  <h2>Recent open-market transactions (90 days)</h2>
  <table><tr><th>Date</th><th>Insider</th><th>Role</th><th>Side</th><th>Shares</th><th>Value</th></tr>{% for r in c.ins_recent %}<tr>{% for v in r %}<td>{{ v }}</td>{% endfor %}</tr>{% endfor %}</table>
  <h2>Top institutional holders</h2>
  <table><tr><th>Holder</th><th>% Out</th><th>Shares</th><th>Reported</th></tr>{% for r in c.inst_rows %}<tr>{% for v in r %}<td>{{ v }}</td>{% endfor %}</tr>{% endfor %}</table>
  <h2>Top executive holders (direct)</h2><p class="note">Shares held directly as reported by Yahoo Finance; holdings through trusts or other entities are not included and can be far larger.</p>
  <table><tr><th>Name</th><th>Role</th><th>Direct shares</th><th>Value</th><th>Reported</th></tr>{% for r in c.exec_rows %}<tr>{% for v in r %}<td>{{ v }}</td>{% endfor %}</tr>{% endfor %}</table></div>

<div class="page">{{ header("Methodology (1/2)") }}
  <h2>Stock rating</h2>
  <p>The Average Score combines six components (Earnings, Fundamental, Relative Valuation, Risk, Price Momentum, Insider Trading) on a 1–10 scale, 10 being most favourable. Scores of {{ c.method.bands.positive[0] }}–{{ c.method.bands.positive[1] }} are positive, {{ c.method.bands.neutral[0] }}–{{ c.method.bands.neutral[1] }} neutral and {{ c.method.bands.negative[0] }}–{{ c.method.bands.negative[1] }} negative. Each component is a decile rank (equal-sized buckets) of the company within its sector cohort across the S&amp;P 500 universe; the Average Score is the simple mean of the available components.</p>
  <h2>Component weights</h2>
  <table><tr><th>Component</th><th>Weighting</th></tr>{% for k, v in c.method.weights.items() %}<tr><td>{{ k }}</td><td style="text-align:left">{{ v }}</td></tr>{% endfor %}</table>
  <h2>Fundamental ratios</h2>
  {% for p, rows in c.method.pillars.items() %}<table style="margin-bottom:6px"><tr><th colspan="2">{{ p }}</th></tr>{% for n, f in rows %}<tr><td>{{ n.replace("_"," ").title() }}</td><td style="text-align:left">{{ f }}</td></tr>{% endfor %}</table>{% endfor %}
  <p class="note">Surprise categories: positive/negative when actual EPS is more than {{ c.method.surprise_pct }}% above/below consensus, otherwise in-line.</p></div>

<div class="page">{{ header("Methodology (2/2) & Disclaimer") }}
  <h2>Approximations in this build</h2>
  <ul><li>Scores are re-implemented from the published LSEG methodology and are not LSEG's proprietary values.</li>
  <li>Earnings factor scores use fixed absolute bins; the Optimized Score uses fixed weights (not the Verus Analytics blend).</li>
  <li>Historical valuation multiples are proxies from annual statements; forward P/E and PEG history are unavailable.</li>
  <li>Data: Yahoo Finance via yfinance; figures can be delayed, restated or incomplete.</li></ul>
  <h2>Insider role codes</h2>
  <table><tr><th>Code</th><th>Role</th></tr>{% for a, b in c.method.roles %}<tr><td>{{ a }}</td><td style="text-align:left">{{ b }}</td></tr>{% endfor %}</table>
  <h2>Disclaimer</h2>
  <p class="note">This report was produced automatically for academic coursework (Goethe University Frankfurt). It is modelled on the layout of an LSEG Stock Reports Plus report but is not affiliated with or endorsed by LSEG. It is provided for information only, does not constitute investment advice or an offer to buy or sell any security, and no warranty is given as to accuracy or completeness. Past performance is not a reliable indicator of future results.</p></div>
</body></html>

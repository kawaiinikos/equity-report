<!doctype html><html><head><meta charset="utf-8"><style>{{ css|safe }}</style></head><body>
{# ---------- macros ---------- #}
{% macro masthead(kind) %}
<div class="mast"><div><div class="co">{{ c.name|upper }} ({{ c.ticker }})</div><div class="ind">{{ c.sector }} · {{ c.gics_sector }}</div></div>
<div class="brand"><div class="logo"><i>AIFA</i> Group<b>5</b></div><div class="kind">{{ kind }}</div><div class="date">Report date: {{ c.date }} · data to {{ c.data_to }}</div></div></div>
<div class="accent"></div>{% endmacro %}

{% macro notes(items) %}{% if items %}<div class="notes"><b>WHY THIS NUMBER LOOKS UNUSUAL</b><ul>{% for n in items %}<li>{{ n }}</li>{% endfor %}</ul></div>{% endif %}{% endmacro %}

{% macro src(text) %}{% if text %}<div class="src">{{ text }}</div>{% endif %}{% endmacro %}

{% macro shead(key, extra_label="") %}{% set k = c.comp[key] %}
<div class="bar"><span>{{ k.title|upper }}</span><small>{{ extra_label }}</small></div>
<div class="shead">
  <div class="tile {{ k.band }}"><div class="lab">{{ k.title if key != "average" else "Average score" }}</div><div class="num">{{ k.score }}</div></div>
  <div class="outlook"><b class="{{ k.band }}">{{ k.band_txt }} outlook.</b><br>{{ k.body }}</div>
  {% if k.box %}<div class="avgbox"><h4>{{ k.title }} Score Averages</h4><table>{% for lab, v in k.box %}<tr><td>{{ lab }}</td><td>{{ v }}</td></tr>{% endfor %}</table></div>{% endif %}
</div>
{% if k.rows %}<div class="row" style="margin-top:4px">
  <div class="w40">{% if not k.flat %}<div class="chart-title">{{ k.title }} Score Trend (4-week moving avg, 3 years)</div>{{ k.chart|safe }}{% else %}<p class="note">{{ k.title }} has no point-in-time history for the whole universe (it needs historical statements and consensus for all S&amp;P 500 stocks), so only current peer scores are shown.</p>{% endif %}</div>
  <div class="col"><table class="trend">{% if k.flat %}<tr><th>Peers</th><th>Current</th></tr>{% for r in k.rows %}<tr class="{{ 'tgt' if r.target }}"><td>{{ r.ticker }}</td><td><span class="cur">{{ r.vals[4] }}</span></td></tr>{% endfor %}
  {% else %}<tr><th>Peers</th><th>-6M</th><th>-3M</th><th>-1M</th><th>-1W</th><th>Current</th><th>1Y Trend</th></tr>
  {% for r in k.rows %}<tr class="{{ 'tgt' if r.target }}"><td>{{ r.ticker }}</td>{% for v in r.vals[:4] %}<td>{{ v }}</td>{% endfor %}<td><span class="cur">{{ r.vals[4] }}</span></td><td class="spark">{{ r.spark|safe }}</td></tr>{% endfor %}{% endif %}</table></div>
</div>{% endif %}{% endmacro %}

{% macro highlights(key) %}{% if c.hl.get(key) %}<div class="bar sub"><span>HIGHLIGHTS</span></div><ul class="hl">{% for h in c.hl[key] %}<li>{{ h }}</li>{% endfor %}</ul>{% endif %}{% endmacro %}

{# ---------- page 1: overview ---------- #}
<div class="page">{{ masthead("DETAILED STOCK REPORT") }}
  <div class="stats">{% for k, v, e in c.stats_top %}<div class="stat"><span>{{ k }}</span><b>{{ v }}</b>{% if e %}<em>{{ e }}</em>{% endif %}</div>{% endfor %}
  {% for k, v, e in c.stats_bot %}<div class="stat"><span>{{ k }}</span><b>{{ v }}</b>{% if e %}<em>{{ e }}</em>{% endif %}</div>{% endfor %}</div>
  {{ shead("average") }}
  <div class="row"><div class="col"><div class="bar sub"><span>HIGHLIGHTS</span><small>{{ c.highlights_source }}</small></div>
    <ul class="hl">{% for b in c.highlights %}<li>{{ b }}</li>{% endfor %}</ul></div>
  <div class="w40"><div class="bar sub"><span>ANALYST CONSENSUS</span></div>
    <div class="big">{{ c.consensus.split(" (")[0] }}</div><div class="note">{{ c.n_analysts }} analysts · mean recommendation {{ "%.2f"|format(c.mean_rec) if c.mean_rec == c.mean_rec else "n/a" }} on a 1 (Strong Buy) – 5 (Strong Sell) scale</div>
    {{ c.consensus_chart|safe }}{{ src(c.an_cite) }}</div></div>
  {{ notes(c.page_notes.overview) }}
  <div class="bar"><span>PRICE AND VOLUME CHARTS</span></div>
  <div class="row"><div class="col"><div class="chart-title">1-Year Return: {{ c.ret_1y }}</div><div class="pv">{{ c.chart_1y|safe }}</div></div>
  <div class="col"><div class="chart-title">5-Year Return: {{ c.ret_5y }}</div><div class="pv">{{ c.chart_5y|safe }}</div></div></div>
  <div class="bar"><span>BUSINESS SUMMARY</span></div><p style="text-align:justify;margin:2px 0">{{ c.summary[:900] }}{% if c.summary|length > 900 %}…{% endif %}</p>
  {{ src("Yahoo Finance (prices, company profile); scores computed by AIFA Group 5 from the sources cited on each page") }}</div>

{# ---------- page 2: indicator components + peers ---------- #}
<div class="page">{{ masthead("DETAILED STOCK REPORT") }}
  <div class="bar"><span>INDICATOR COMPONENTS</span></div>
  <div class="shead"><div class="tile {{ c.comp.average.band }}"><div class="lab">Average score</div><div class="num">{{ c.comp.average.score }}</div></div>
  <div class="outlook">The <b>Average Score</b> combines six widely used investment decision tools – Earnings, Fundamental, Relative Valuation, Risk, Price Momentum and Insider Trading. Each component is a decile rank (1–10, 10 most favourable) of the stock within its S&amp;P 500 sector; the Average Score is their simple mean. Factors can behave differently across industries and market-cap groups, so use the score alongside other research.</div></div>
  {{ c.overview_gauge|safe }}
  <div class="bar"><span>OPTIMIZED SCORE</span></div>
  <div class="shead"><div class="tile neu"><div class="lab">Optimized</div><div class="num">{{ c.opt_score }}</div></div>
  <div class="outlook">An alternative to equal weighting: a fixed-weight blend that leans on Earnings, Fundamental and Price Momentum (20% each), Relative Valuation and Risk (15% each) and Insider Trading (10%). LSEG's Optimized Score uses back-tested weights from Verus Analytics that are not public, so this score is our approximation.</div></div>
  <div class="bar"><span>PEER ANALYSIS</span><small>Currency in {{ c.currency }}</small></div>
  <table><tr><th>Avg Score</th><th class="l">Ticker</th><th>Price</th><th>1-Mo</th><th>3-Mo</th><th>1-Yr</th><th>Market Cap</th><th>Trailing PE</th><th>Forward PE</th><th>Div Yield</th><th>Net Margin</th></tr>
  {% for r in c.peer_rows2 %}<tr class="{{ 'tgt' if r.target }} {{ 'avg' if r.avg }}">{% for v in r.cells %}<td {% if loop.index == 2 %}class="l"{% endif %}>{{ v }}</td>{% endfor %}</tr>{% endfor %}</table>
  <div class="note">{% if c.peer_method == 'similarity' %}Peers: the S&amp;P 500 companies most similar to {{ c.ticker }} on a blend of business description (most weight), 10-K revenue mix, financial profile, size and industry code (see methodology). LSEG picks peers with its own TRBC-based method, so peer sets differ.{% else %}Peers: nearest market capitalisation in the same GICS sub-industry, then sector (S&amp;P 500). LSEG uses its TRBC industry classification, so peer sets differ.{% endif %}</div>
  <div class="bar sub"><span>PEER COMPANIES</span><small>closest match on</small></div>
  <div class="grid4">{% for t, n, why in c.peer_names %}<div><b>{{ t }}</b> {{ n }}{% if why %}<br><span class="note">{{ why }}</span>{% endif %}</div>{% endfor %}</div>
  {{ src("Yahoo Finance prices, key statistics and business descriptions; SEC EDGAR 10-K revenue by business line and SIC codes; S&P 500 constituents and GICS classification from Wikipedia") }}</div>

{# ---------- page 3: earnings ---------- #}
<div class="page">{{ masthead("DETAILED STOCK REPORT") }}
  {{ shead("earnings", "Currency in " ~ c.currency) }}
  <div class="bar"><span>EARNINGS INDICATORS</span></div>{{ c.comp.earnings.gauge|safe }}
  <div class="row"><div class="col"><table class="kv"><tr><th colspan="2" class="l">Last 4 Quarters</th></tr>
    <tr><td># Positive Surprises (&gt;{{ c.method.surprise_pct|int }}%)</td><td>{{ c.surp_summary.get("pos4", "n/a") }}</td></tr>
    <tr><td># Negative Surprises (&lt;-{{ c.method.surprise_pct|int }}%)</td><td>{{ c.surp_summary.get("neg4", "n/a") }}</td></tr>
    <tr><td># In-Line Surprises</td><td>{{ c.surp_summary.get("inline4", "n/a") }}</td></tr>
    <tr><td>Avg Surprise</td><td>{{ (c.surp_summary.mean4 * 100)|round(1) ~ "%" if c.surp_summary.get("mean4") is not none else "n/a" }}</td></tr></table></div>
  <div class="col"><table class="kv"><tr><th colspan="2" class="l">Last 4 Weeks</th></tr>
    <tr><td># Up Revisions</td><td>{{ c.rev_stats.get("up30", "n/a") }}</td></tr><tr><td># Down Revisions</td><td>{{ c.rev_stats.get("down30", "n/a") }}</td></tr>
    <tr><td>Avg change in consensus (30d)</td><td>{{ (c.rev_stats.pct30 * 100)|round(1) ~ "%" if c.rev_stats.get("pct30") is not none else "n/a" }}</td></tr></table></div>
  <div class="col"><table class="kv"><tr><th colspan="2" class="l">Last 120 Days</th></tr>
    <tr><td># Broker Upgrades</td><td>{{ c.rc_stats.get("up", "n/a") }}</td></tr><tr><td># Broker Downgrades</td><td>{{ c.rc_stats.get("down", "n/a") }}</td></tr></table></div></div>
  {{ notes(c.page_notes.earnings) }}
  <div class="row"><div class="col">{{ highlights("earnings") }}
    <div class="bar sub"><span>BROKER RATING ACTIONS</span><small>last 120 days</small></div>
    <table><tr><th class="l">Date</th><th class="l">Firm</th><th class="l">Action</th><th class="l">Rating</th><th>Target</th></tr>
    {% for r in c.broker_rows[:7] %}<tr>{% for v in r %}<td {% if loop.index < 5 %}class="l"{% endif %}>{{ v }}</td>{% endfor %}</tr>{% else %}<tr><td colspan="5">No broker actions in the window.</td></tr>{% endfor %}</table>
    {{ src("Yahoo Finance broker research actions (firm, rating and price-target changes)") }}</div>
  <div class="w40"><div class="bar sub"><span>PRICE TARGET</span></div>
    <div class="cap">{{ c.fan_chart|safe }}</div>
    <table class="kv"><tr><th colspan="2" class="l">12-Month Price Target</th></tr><tr><td>Mean</td><td>{{ "%.2f"|format(c.pt.mean) if c.pt.mean else "n/a" }}</td></tr>
    <tr><td>High</td><td>{{ "%.2f"|format(c.pt.high) if c.pt.high else "n/a" }}</td></tr><tr><td>Low</td><td>{{ "%.2f"|format(c.pt.low) if c.pt.low else "n/a" }}</td></tr>
    <tr><td>Target vs. Current</td><td>{{ c.pt_vs_current }}</td></tr><tr><td># of Analysts</td><td>{{ c.n_analysts }}</td></tr></table>
    {{ src(c.an_cite) }}<div class="note">{{ c.an_note }}</div></div></div></div>

{# ---------- page 4: EPS ---------- #}
<div class="page">{{ masthead("DETAILED STOCK REPORT") }}
  <div class="bar"><span>EARNINGS PER SHARE</span></div>
  <div class="row"><div class="w35"><p>Earnings per share (EPS) is net income divided by shares outstanding. The charts compare reported EPS with the analysts' consensus, including the high–low range of estimates for future periods.</p>
    <table><tr><th class="l">Period</th><th>Mean</th><th>Low</th><th>High</th><th>#</th></tr>{% for r in c.est_rows %}<tr>{% for v in r %}<td>{{ v }}</td>{% endfor %}</tr>{% endfor %}</table></div>
  <div class="col">{{ c.eps_q_chart|safe }}</div><div class="col">{{ c.eps_a_chart|safe }}</div></div>
  <div class="row"><div class="col"><div class="bar sub"><span>MEAN ESTIMATE TREND</span></div>
    <table><tr><th class="l">Period</th><th>Current</th><th>30 Days Ago</th><th>90 Days Ago</th><th>% Change (90 Days)</th></tr>{% for r in c.trend_rows %}<tr>{% for v in r %}<td>{{ v }}</td>{% endfor %}</tr>{% endfor %}</table></div>
  <div class="col"><div class="bar sub"><span>ANALYST RECOMMENDATIONS</span></div><div class="cap">{{ c.rec_chart|safe }}</div></div></div>
  <div class="bar"><span>EARNINGS SURPRISES</span></div>
  <div class="row"><div class="w35"><p>A surprise is the difference between reported EPS and the consensus estimate. Research shows a reported surprise is often followed by more surprises in the same direction.</p>
    {% if c.surp_summary %}<table class="kv"><tr><th colspan="2" class="l">Surprise Summary (last 12 quarters)</th></tr>
    <tr><td>Positive quarters (&gt;{{ c.method.surprise_pct|int }}%)</td><td>{{ c.surp_summary.pos }}</td></tr><tr><td>Negative quarters</td><td>{{ c.surp_summary.neg }}</td></tr>
    <tr><td>In-line quarters</td><td>{{ c.surp_summary.inline }}</td></tr></table>{% endif %}</div>
  <div class="col"><table><tr><th class="l">Announce Date</th><th>Actual EPS</th><th>Mean EPS</th><th>Surprise</th><th class="l">Type</th></tr>
    {% for r in c.surprise_rows %}<tr>{% for v in r %}<td {% if loop.last %}class="l"{% endif %}>{{ v }}</td>{% endfor %}</tr>{% endfor %}</table>
    <div class="note">"Not comparable" = surprise above ±{{ c.method.surprise_outlier }}%: the reported EPS includes one-off items the consensus excludes; those quarters are left out of the counts and the score.</div></div></div>
  <div class="bar"><span>ANNUAL REVENUE</span></div>
  <div class="row"><div class="w35"><p>Rising sales together with rising EPS tend to support a buy recommendation; flat sales with rising EPS may come from cost cuts rather than growth.</p></div>
  <div class="col"><table><tr><th class="l">Period</th><th>Revenue (USD bn)</th></tr>{% for r in c.rev_rows %}<tr>{% for v in r %}<td>{{ v }}</td>{% endfor %}</tr>{% endfor %}</table></div></div>
  {{ src("Yahoo Finance consensus estimates, EPS trend and earnings history") }}</div>

{# ---------- page 5: fundamental ---------- #}
<div class="page">{{ masthead("DETAILED STOCK REPORT") }}
  {{ shead("fundamental") }}
  <div class="bar"><span>FUNDAMENTAL INDICATORS</span></div>{{ c.comp.fundamental.gauge|safe }}
  <div class="grid4">{% for pillar, rows in c.fundamental.items() %}<div>{% for name, formula, val in rows %}<div class="rbox"><div class="k"><span>{{ name }}</span><span>{{ val }}</span></div><div class="p">{{ formula }}</div></div>{% endfor %}</div>{% endfor %}</div>
  <div class="note">Ratios use the four latest quarters (TTM) or the latest balance sheet available {{ c.stmt_lag }} days before the report date (latest period: {{ c.stmt_end }}).</div>
  {{ notes(c.page_notes.fundamental) }}
  {{ highlights("fundamental") }}
  {{ src("Yahoo Finance financial statements; scores ranked against the S&P 500 sector") }}</div>

{# ---------- page 6: relative valuation ---------- #}
<div class="page">{{ masthead("DETAILED STOCK REPORT") }}
  {{ shead("relative_valuation") }}
  <div class="bar"><span>RELATIVE VALUATION INDICATORS</span></div>{{ c.comp.relative_valuation.gauge|safe }}
  <div class="grid3">{% for v in c.val_cards %}<div class="card"><h5>{{ v.name }}</h5><table class="kv">
    <tr><td>Current</td><td>{{ v.current }}</td></tr><tr><td>5-Yr Average</td><td>{{ v.avg5 }}</td></tr>
    <tr><td>Rel. to 5-Yr Avg.</td><td class="{{ 'pos' if v.rel5 < 0 else 'neg' }}">{{ ("%.0f%% %s"|format((v.rel5|abs) * 100, "Discount" if v.rel5 < 0 else "Premium")) if v.rel5 == v.rel5 else "n/a" }}</td></tr>
    <tr><td>S&amp;P 500 median</td><td>{{ v.sp }}</td></tr>
    <tr><td>Rel. to S&amp;P 500</td><td class="{{ 'pos' if v.relsp < 0 else 'neg' }}">{{ ("%.0f%% %s"|format((v.relsp|abs) * 100, "Discount" if v.relsp < 0 else "Premium")) if v.relsp == v.relsp else "n/a" }}</td></tr>
    <tr><td>Industry median</td><td>{{ v.ind }}</td></tr></table></div>{% endfor %}</div>
  {{ notes(c.page_notes.relative_valuation) }}
  {{ highlights("relative_valuation") }}
  {{ src("Yahoo Finance prices, statements and forward EPS; medians over the S&P 500 universe") }}</div>

{# ---------- page 7: valuation history ---------- #}
<div class="page">{{ masthead("DETAILED STOCK REPORT") }}
  <div class="row"><div class="col"><div class="bar"><span>PRICE TO SALES</span></div><p class="note">Weekly close divided by trailing-12-month revenue per share.</p>{{ c.hist_ps|safe }}</div>
  <div class="col"><div class="bar"><span>TRAILING PE</span></div><p class="note">Weekly close divided by the sum of the four most recently reported quarters of diluted EPS.</p>{{ c.hist_pe|safe }}</div></div>
  <div class="row"><div class="col"><div class="bar"><span>FORWARD PE</span></div>
    {% if c.fpe_chart %}<p class="note">Weekly close divided by the I/B/E/S next-12-month consensus EPS.</p>{{ c.fpe_chart|safe }}{{ src(c.fpe_cite) }}
    {% else %}<div class="card"><p>Current forward P/E: <b>{{ c.val_cards[2].current }}</b> · S&amp;P 500 median {{ c.val_cards[2].sp }} · industry median {{ c.val_cards[2].ind }}.</p>
    <p class="note">A forward P/E history needs the consensus EPS as it stood on each past date. Yahoo Finance only publishes today's consensus. Select <b>LSEG Workspace</b> or <b>WRDS (I/B/E/S)</b> as the analyst source to draw this chart.</p></div>{% endif %}</div>
  <div class="col"><div class="bar"><span>FORWARD PEG</span></div><div class="card"><p>Current forward PEG: <b>{{ c.peg }}</b> (forward P/E divided by the long-term EPS growth forecast).</p>
    <p class="note">Like the forward P/E, a PEG history needs point-in-time consensus growth forecasts (LSEG I/B/E/S or WRDS).</p></div></div></div>
  {{ notes(c.page_notes.relative_valuation[:1]) }}
  {{ src("Yahoo Finance prices and quarterly/annual statements (reporting lag " ~ c.stmt_lag ~ " days)") }}</div>

{# ---------- page 8: risk ---------- #}
<div class="page">{{ masthead("DETAILED STOCK REPORT") }}
  {{ shead("risk") }}
  <div class="bar"><span>RISK INDICATORS</span></div>{{ c.comp.risk.gauge|safe }}
  <div class="grid3">{% for title, kv in c.risk_boxes %}<div class="card"><h5>{{ title }}</h5><table class="kv">{% for k, v in kv %}<tr><td>{{ k }}</td><td>{{ v }}</td></tr>{% endfor %}</table></div>{% endfor %}</div>
  {{ notes(c.page_notes.risk) }}
  <div class="row"><div class="w40">{{ highlights("risk") }}</div>
  <div class="col"><div class="bar sub"><span>RISK ANALYSIS</span><small>daily: last 90 days · monthly: last 60 months</small></div>
    <table><tr><th class="l">Peers</th><th>Best Daily</th><th>Worst Daily</th><th># Days Up</th><th># Days Down</th><th>Best Monthly</th><th>Worst Monthly</th></tr>
    {% for r in c.risk_rows2 %}<tr class="{{ 'tgt' if r.target }}">{% for v in r.cells %}<td>{{ v }}</td>{% endfor %}</tr>{% endfor %}</table></div></div>
  {{ src("Yahoo Finance daily prices; S&P 500 index (^GSPC)") }}</div>

{# ---------- page 9: price momentum ---------- #}
<div class="page">{{ masthead("DETAILED STOCK REPORT") }}
  {{ shead("price_momentum", "Currency in " ~ c.currency) }}
  <div class="bar"><span>PRICE MOMENTUM INDICATORS</span></div>{{ c.comp.price_momentum.gauge|safe }}
  <div class="row"><div class="col"><table><tr><th class="l">Relative Strength Indicator (1–100)</th><th>{{ c.ticker }}</th><th>Sector Avg</th></tr>
    {% for a, b, s in c.rsi_rows %}<tr><td>{{ a }}</td><td>{{ b }}</td><td>{{ s }}</td></tr>{% endfor %}</table></div>
  <div class="col"><table><tr><th class="l">Average Monthly Return (last 10 years)</th>{% for m in c.season_rows %}<th>{{ m[0] }}</th>{% endfor %}</tr>
    <tr><td>Company avg</td>{% for m in c.season_rows %}<td>{{ m[1] }}</td>{% endfor %}</tr>
    <tr><td>Sector avg</td>{% for m in c.season_rows %}<td>{{ m[2] }}</td>{% endfor %}</tr>
    <tr><td>Sector rank</td>{% for m in c.season_rows %}<td>{{ m[3] }}</td>{% endfor %}</tr></table></div></div>
  <div class="bar"><span>PRICE PERFORMANCE</span></div>
  <div class="row"><div class="col">{{ c.perf_chart|safe }}</div>
  <div class="col"><table><tr><th class="l"></th><th>{{ c.ticker }}</th><th>DJIA</th></tr>{% for a, b, x in c.perf_side %}<tr><td>{{ a }}</td><td>{{ b }}</td><td>{{ x }}</td></tr>{% endfor %}</table>
    {{ highlights("price_momentum") }}</div></div>
  {{ src("Yahoo Finance daily prices for the stock, the S&P 500 universe and the Dow Jones Industrial Average") }}</div>

{# ---------- page 10: insider trading ---------- #}
<div class="page">{{ masthead("DETAILED STOCK REPORT") }}
  {{ shead("insider_trading", "Currency in " ~ c.currency) }}
  <div class="bar"><span>INSIDER TRADING INDICATORS</span></div>{{ c.comp.insider_trading.gauge|safe }}
  <div class="row"><div class="col"><div class="bar sub"><span>MOST RECENT BUYS AND SELLS</span><small>last 90 days</small></div>
    <table><tr><th class="l">Date</th><th class="l">Insider</th><th class="l">Role</th><th class="l">Type</th><th>Shares</th><th>Value</th></tr>
    {% for r in c.ins_recent[:5] %}<tr>{% for v in r %}<td {% if loop.index < 5 %}class="l"{% endif %}>{{ v|truncate(26, True, "…") if loop.index == 3 else v }}</td>{% endfor %}</tr>{% else %}<tr><td colspan="6">No open-market trades in the last 90 days.</td></tr>{% endfor %}</table>
    {{ highlights("insider_trading") }}</div>
  <div class="w35"><div class="bar sub"><span>INSIDER SUMMARY</span><small>last 6 months</small></div>
    <table class="kv"><tr><td>Shares acquired</td><td>{{ "{:,}".format(c.ins_sum.acquired) }}</td></tr><tr><td>Shares disposed</td><td>{{ "{:,}".format(c.ins_sum.disposed) }}</td></tr>
    <tr><td>Net shares</td><td>{{ "{:,}".format(c.ins_sum.net) }}</td></tr></table>
    <div class="bar sub"><span>MONTHLY BUYS AND SELLS</span></div><div class="cap">{{ c.ins_chart|safe }}</div></div></div>
  {{ src(c.ins_cite) }}
  <div class="row"><div class="col"><div class="bar sub"><span>TOP INSTITUTIONAL HOLDERS</span></div>
    <table><tr><th class="l">Institution</th><th>% O/S</th><th>Shares</th><th>Reported</th></tr>{% for r in c.inst_rows %}<tr>{% for v in r %}<td>{{ v }}</td>{% endfor %}</tr>{% endfor %}</table>
    {{ src("Yahoo Finance institutional holders (13F filings)") }}</div>
  <div class="col"><div class="bar sub"><span>TOP EXECUTIVE HOLDERS</span></div>
    <table><tr><th class="l">Insider</th><th class="l">Role</th><th>Direct</th><th>Indirect</th><th>Value</th><th>As of</th></tr>{% for r in c.exec_rows %}<tr>{% for v in r %}<td {% if loop.index < 3 %}class="l"{% endif %}>{{ v|truncate(24, True, "…") if loop.index == 2 else v }}</td>{% endfor %}</tr>{% endfor %}</table>
    {{ src(c.exec_cite) }}</div></div></div>

{# ---------- page 11: methodology ---------- #}
<div class="page method">{{ masthead("METHODOLOGY") }}
  <div class="row"><div class="col">
  <h3>Average Score</h3><p>Combines six components – Earnings, Fundamental, Relative Valuation, Risk, Price Momentum and Insider Trading – each a decile rank (1–10, 10 most favourable) of the stock within its S&amp;P 500 sector cohort (the whole index when the sector has fewer than 30 rated stocks). The Average Score is the simple mean of the available components (at least four). Scores of {{ c.method.bands.positive[0] }}–{{ c.method.bands.positive[1] }} are positive, {{ c.method.bands.neutral[0] }}–{{ c.method.bands.neutral[1] }} neutral and {{ c.method.bands.negative[0] }}–{{ c.method.bands.negative[1] }} negative.</p>
  <h3>Score history and averages</h3><p>Risk and Price Momentum are re-ranked every week against the sector using only prices up to that date. Earnings and Insider Trading are rebuilt as of each date from dated events (EPS surprises, broker up/downgrades, open-market insider trades) collected for every S&amp;P 500 stock. Fundamental and Relative Valuation are held at their current values. Trend tables and charts show a 4-week moving average. Score Averages cover the peer group, the GICS sector, the 100 largest companies and the whole S&amp;P 500.</p>
  <h3>Component weights</h3>
  <table>{% for k, v in c.method.weights.items() %}<tr><td>{{ k }}</td><td class="l">{{ v }}</td></tr>{% endfor %}</table>
  <h3>Data cut-off</h3><p>Report date {{ c.date }}; prices to the previous close; financial statements count as known {{ c.stmt_lag }} days after the period end. Analyst estimates, price targets and holder lists from Yahoo Finance are its latest snapshot (LSEG Workspace and WRDS sources are point-in-time).</p>
  </div><div class="col">
  <h3>Fundamental ratios</h3>
  {% for p, rows in c.method.pillars.items() %}<table style="margin-bottom:4px"><tr><th colspan="2" class="l">{{ p }} (25%)</th></tr>{% for n, f in rows %}<tr><td>{{ n.replace("_"," ").title() }}</td><td class="l">{{ f }}</td></tr>{% endfor %}</table>{% endfor %}
  <h3>Surprises</h3><p>Positive/negative when reported EPS is more than {{ c.method.surprise_pct }}% above/below consensus, otherwise in-line; surprises beyond ±{{ c.method.surprise_outlier }}% are treated as not comparable (one-off items).</p>
  </div></div></div>

{# ---------- page 12: sources, cross-check, disclaimer ---------- #}
<div class="page method">{{ masthead("DATA SOURCES & DISCLAIMER") }}
  <h3>Data sources used in this report</h3>
  <table><tr><th class="l">Block</th><th class="l">Source</th></tr>
  <tr><td>Prices, volumes, company profile, statements</td><td class="l">Yahoo Finance via the open-source yfinance library</td></tr>
  <tr><td>Analyst consensus, price targets</td><td class="l">{{ c.an_cite }}</td></tr>
  <tr><td>Broker rating actions</td><td class="l">Yahoo Finance broker research actions</td></tr>
  <tr><td>Insider transactions</td><td class="l">{{ c.ins_cite }}</td></tr>
  <tr><td>Executive holdings</td><td class="l">{{ c.exec_cite }}</td></tr>
  <tr><td>Market-wide earnings / insider events</td><td class="l">Yahoo Finance, {{ c.market_events_n }} S&amp;P 500 companies (scripts/build_market_events.py)</td></tr>
  <tr><td>Peer selection inputs</td><td class="l">Yahoo Finance business descriptions; SEC EDGAR 10-K XBRL revenue by segment and product line, SIC codes (scripts/build_peer_features.py)</td></tr>
  <tr><td>Universe and sectors</td><td class="l">S&amp;P 500 constituents and GICS classification (Wikipedia list), 10 years of daily prices</td></tr></table>
  {% if c.cmp_rows and c.cmp_head|length > 1 %}<h3>Source cross-check (same figures from different providers)</h3>
  <table><tr><th class="l">Item</th>{% for h in c.cmp_head %}<th>{{ h }}</th>{% endfor %}</tr>{% for r in c.cmp_rows %}<tr>{% for v in r %}<td>{{ v }}</td>{% endfor %}</tr>{% endfor %}</table>
  {% for x in c.cmp_cites %}<div class="src">{{ x }}</div>{% endfor %}
  <p class="note">Differences usually come from restatements (Yahoo restates past periods, e.g. for discontinued operations; SEC figures are as originally filed), from different TTM windows, or from different definitions (e.g. ROE on average vs. ending equity).</p>{% endif %}
  <h3>Approximations</h3><ul class="hl">
  <li>Scores re-implement the published LSEG Stock Reports Plus methodology on an S&amp;P 500 universe; they are not LSEG's proprietary values (LSEG ranks a global universe with I/B/E/S data).</li>
  <li>Earnings factor scores use fixed bins; the Optimized Score uses fixed weights (not the Verus Analytics blend).</li>
  <li>Peers are chosen by our similarity blend, not LSEG's TRBC-based peer method; sector averages use GICS, not TRBC.</li></ul>
  {% if c.peer_method == 'similarity' %}<h3>Peer selection</h3><p>Every S&amp;P 500 company is scored on five signals, each converted to a percentile among all candidates and blended with the weights below (a signal that is missing for a company, e.g. no 10-K segment data for a non-US filer, is dropped and the other weights rescaled). Business description and revenue mix use TF-IDF text similarity; the revenue mix weights each 10-K business line by its share of revenue. Price behaviour is deliberately not used: peers should run similar businesses, not merely trade alike. Weights were checked against LSEG's published peer lists for HON and AMZN, which is too small a sample to call them calibrated.</p>
  <div class="grid3">{% for n, w in c.peer_weights %}<div><b>{{ w }}</b> {{ n }}</div>{% endfor %}</div>{% endif %}
  <h3>Insider role codes</h3>
  <div class="grid4">{% for a, b in c.method.roles %}<div><b>{{ a }}</b> {{ b }}</div>{% endfor %}</div>
